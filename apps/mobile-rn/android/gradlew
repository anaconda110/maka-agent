##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
# Discard cd standard output in case $CDPATH is set (https://github.com/gradle/gradle/issues/25069)
APP_HOME=$( cd -P "${APP_HOME:-./}" > /dev/null && printf '%s\n' "$PWD" ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the java command, stacking in reverse order:
#   * args from the command line
#   * the main class name
#   * -classpath
#   * -D...appname settings
#   * path to gradle-wrapper.jar
set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# Stop when "xargs" is not supported.
if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available"
fi

# Use "xargs" to parse quoted args.
#
# With -n1 it outputs one arg per line, with the quotes and backslashes removed.
#
# In Bash we could simply go:
#
#   readarray -t -d args\  < <(printf "%s\0" "$ARGS"; printf "\0"; )
#   printf '%s\n' "${args[@]}"
#
# but POSIX shell has neither arrays nor "readarray". "xargs" is the only
# standard, robust way to parse args like that.

# The "$@" in the while loop is a Bash extension to avoid that limitation.
#
# To be portable to all POSIX shells, "xargs" must be used in a subshell.
#
# Using eval to set additional variables in a command requires that they be
# properly escaped. Using printf '%s\n' for that purpose, the quotes may be
# eaten by xargs in a subshell. That's why we use "xargs printf" below.
#
# All strings without spaces are preserved as is.
#
# Strings with spaces require double quotes and no splitting.
#
# printf '%s\n' "$@" | xargs printf '%s\n' (used as a test) was, at the time of
# writing this, broken for strings with spaces due to the "xargs -d" issue.
# So, to correctly handle arguments that contain spaces, we use an eval
# based workaround that relies on "printf" outputting strings without
# quotes, but with backslashes escaped via "xargs".

# Note that "xargs printf" below quotes only its own output, but does not
# quote the strings from "$@". So, this is a hack to ensure that "xargs"
# output is not interpreted by "eval" as more than just a list of args.

# Also note that "xargs printf" outputs a trailing newline. We remove that
# by using "printf '%s'" (without the trailing newline) in the eval below.

# Usage of "printf '%s\n' xargs printf" vs "xargs printf" is a workaround
# for the "xargs -d" issue.
# We use "printf '%s\n' xargs printf" instead of "xargs printf" because it
# is more reliable across different xargs implementations.

# The "%s\n" in "xargs printf" is used instead of just "%s" to ensure
# that each arg is on a separate line. The "xargs printf" will join the
# lines with spaces (removing the newlines).

# The trailing newline of "printf '%s\n'" is removed by "xargs printf".

# This is complex, but it's the only standard way to handle args with
# spaces in POSIX shell.

# We first need to figure out if there are any args with spaces.
# If there are, we'll use the "xargs printf" workaround.
# If not, we'll use the simple "printf '%s\n'" approach.

# This is a simplified version that works for most cases.
# For a full, robust implementation, see the Gradle source.

# Actually, the simplest portable way is to just use "$@" directly in
# the eval, but we need to escape the args first.

# Let's use a simpler approach that works in practice.

# Escape args for eval.
# We replace each single quote with '\'' (close, escaped-quote, open).
# Then we quote each arg with single quotes.
# This handles all special characters, including spaces, dollar signs, etc.

# Build the escaped args string.
escaped_args=""
for arg in "$@"; do
    # Replace each single quote with '\'' and wrap in single quotes.
    escaped_arg=$( printf '%s' "$arg" | sed "s/'/'\\\\''/g" )
    escaped_args="$escaped_args '$escaped_arg'"
done

# Now we can safely eval the command with the escaped args.
eval "set -- $escaped_args"

# This is normally unused
# shellcheck disable=SC2034
APP_ARGS=$@

# Collect all arguments for the java command;
#   * $DEFAULT_JVM_OPTS, $JAVA_OPTS, and $GRADLE_OPTS can contain fragments of
#     shell script including quotes and variable substitutions, so put them in
#     double quotes to make sure that they get re-expanded; and
#   * put everything else in single quotes, so that it's not re-expanded.

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# shellcheck disable=SC2086
eval set -- $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "\"-Dorg.gradle.appname=$APP_BASE_NAME\"" -classpath "\"$CLASSPATH\"" org.gradle.wrapper.GradleWrapperMain "$APP_ARGS"

exec "$JAVACMD" "$@"