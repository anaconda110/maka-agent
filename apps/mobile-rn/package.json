{
  "name": "@maka/mobile-rn",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Maka Android / React Native client — cloud-first model connection and runtime-host adapter.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --variant=release",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "bundle:android:release": "cd android && ./gradlew bundleRelease",
    "clean:android": "cd android && ./gradlew clean",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "jest"
  },
  "dependencies": {
    "@maka/core": "0.1.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "react-native-keychain": "^9.2.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-sqlite-storage": "^6.0.2",
    "react": "^19.2.1",
    "react-native": "^0.79.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@biomejs/biome": "2.5.4",
    "@react-native/babel-preset": "^0.79.7",
    "@react-native/metro-config": "^0.79.7",
    "@types/react": "^19.2.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react-native-dotenv": "^3.4.11",
    "typescript": "^7.0.2"
  }
}